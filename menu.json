{
    "notes": [
        "This is a standard menu for Raspberry Pi 5.",
        "Please refer to the README file for instruction on how to ",
        "build to build the image."
    ],
    "sources": [
        {
            "url": "https://git.yoctoproject.org/poky",
            "branch": "scarthgap",
            "dir": "poky"
        },
        {
            "url": "https://git.openembedded.org/meta-openembedded",
            "branch": "scarthgap",
            "dir": "meta-openembedded"
        },
        {
            "url": "https://git.yoctoproject.org/meta-raspberrypi",
            "branch": "scarthgap",
            "dir": "meta-raspberrypi"
        },
        {
            "url": "https://git.yoctoproject.org/meta-virtualization",
            "branch": "scarthgap",
            "dir": "meta-virtualization"
        }
    ],
    "layers": [
        "poky/meta",
        "poky/meta-poky",
        "poky/meta-yocto-bsp",
        "meta-openembedded/meta-oe"
    ],
    "local.conf": [
        "INHERIT += 'rm_work'"
    ],
    "builds": {
        "dev-pyro-rpi5": {
            "target": "pyronear-image",
            "layers": [
                "meta-raspberrypi",
                "meta-openembedded/meta-python",
                "meta-openembedded/meta-networking",
                "meta-openembedded/meta-multimedia",
                "meta-openembedded/meta-filesystems",
                "meta-virtualization",
                "../local-layers/meta-pyronear"
            ],
            "local.conf": [
                "MACHINE = 'pyronear-rpi5'                               ",
                "DISTRO = 'pyronear-os'                                  ",
                "RM_WORK_EXCLUDE += 'pyro-setup'                         "
            ]
        }
    }
}