[Unit]
Description=Persistent fake home directory for Ansible checkout
DefaultDependencies=no
Requires=data.mount
After=data.mount systemd-tmpfiles-setup.service
Before=multi-user.target

[Mount]
What=/data/pyro-engine-src
Where=/home/pyro-engine
Type=none
Options=bind

[Install]
WantedBy=multi-user.target