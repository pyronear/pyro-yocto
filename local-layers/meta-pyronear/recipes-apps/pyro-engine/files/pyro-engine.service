[Unit]
Description=PyroEngine Application Start
# CORRECTED: Waiting for the network to be ONLINE and the clock to be SYNCHRONIZED
After=docker.service pyro-init.service network-online.target time-sync.target
Wants=docker.service network-online.target time-sync.target

[Service]
Type=oneshot
User=dev
Group=docker
WorkingDirectory=/data/pyro-engine-home

# SECURITY EMBEDDED: A verification loop in case systemd-timesyncd is lazy
# This script blocks the service as long as the year/month corresponds to the build date (March 13)
ExecStartPre=/bin/sh -c 'until [ $(date +%%s) -gt 1773416400 ]; do echo "Waiting for network time synchronization..."; sleep 1; done'
ExecStartPre=/data/pyro-engine-home/refresh_token.sh
ExecStartPre=/bin/sh -c 'if [ ! -f .images_loaded ]; then echo "Loading Docker image..."; docker load -i pyro-images.tar && touch .images_loaded; fi'

ExecStart=/usr/bin/docker compose up -d
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target