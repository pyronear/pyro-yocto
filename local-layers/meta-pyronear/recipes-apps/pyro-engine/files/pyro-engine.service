[Unit]
Description=PyroEngine Application Start
After=docker.service pyro-init.service network-online.target time-sync.target
Wants=docker.service network-online.target time-sync.target

ConditionPathExists=/data/pyro-engine-home/docker-compose.yml

[Service]
Type=oneshot
# Run as non-privileged 'engine' user for security hardening
User=engine
Group=docker
WorkingDirectory=/data/pyro-engine-home

# Verify network time synchronization (blocking start until system clock is updated)
ExecStartPre=/bin/sh -c 'until [ $(date +%%s) -gt 1773416400 ]; do echo "Waiting for network time synchronization..."; sleep 1; done'

# Main orchestration command: launch the containers in detached mode
ExecStart=/usr/bin/docker-compose up -d

RemainAfterExit=yes

[Install]
WantedBy=multi-user.target