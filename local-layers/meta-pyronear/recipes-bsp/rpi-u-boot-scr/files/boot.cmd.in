# BOOT_ORDER defines the priority order of the slots (A then B by default)
# BOOT_X_LEFT indicates the number of remaining boot attempts for slot X
test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3

setenv bootpart
setenv raucslot

# Selection of the active slot based on priority and the number of remaining attempts
for BOOT_SLOT in "${BOOT_ORDER}"; do
  if test "x${bootpart}" != "x"; then
    echo "Slot found, skipping others."
  elif test "x${BOOT_SLOT}" = "xA"; then
    if itest ${BOOT_A_LEFT} -gt 0; then
      # Decrement the number of attempts for slot A and configure its root partition
      setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
      echo "Found valid RAUC slot A"
      setenv bootpart "/dev/mmcblk0p2"
      setenv raucslot "A"
    fi
  elif test "x${BOOT_SLOT}" = "xB"; then
    if itest ${BOOT_B_LEFT} -gt 0; then
      # Decrement the number of attempts for slot B and configure its root partition
      setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
      echo "Found valid RAUC slot B"
      setenv bootpart "/dev/mmcblk0p3"
      setenv raucslot "B"
    fi
  fi
done

# If a valid slot has been selected, configure the Linux kernel arguments
# Otherwise, if no slot is bootable, reset the counters to 3 and restart
if test -n "${bootpart}"; then
  setenv bootargs "root=${bootpart} ro rootwait console=ttyAMA0,115200 console=tty1 rauc.slot=${raucslot}"
  saveenv
else
  echo "No valid RAUC slot found. Resetting tries to 3"
  setenv BOOT_A_LEFT 3
  setenv BOOT_B_LEFT 3
  saveenv
  reset
fi

# Initial save of the environment if it doesn't exist yet on the storage medium
if test ! -e mmc 0:1 uboot.env; then saveenv; fi;

# Loading and preparing the device tree (Device Tree / FDT)
fdt addr ${fdt_addr}
fdt resize 8192

# Loading the Linux kernel image (Image) from the boot partition
fatload mmc 0:1 ${kernel_addr_r} Image

# Starting the Linux kernel with the configured device tree
booti ${kernel_addr_r} - ${fdt_addr}